FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application         simpleFoam;
startFrom           startTime;
startTime           0;
stopAt              endTime;
endTime             1000;
deltaT              1;
writeControl        timeStep;
writeInterval       1000;
purgeWrite          1;
writeFormat         binary;
writePrecision      10;
writeCompression    off;
timeFormat          general;
timePrecision       10;
runTimeModifiable   true;
