FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }
    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.05;
    }
    k
    {
        $U;
    }
    omega
    {
        $U;
    }
    cellDisplacement
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
}
SIMPLE
{
    momentumPredictor       yes;
    consistent              yes;
    nNonOrthogonalCorrectors 1;
    pRefCell                0;
    pRefValue               0;
    residualControl
    {
        p                   5e-4;
        U                   2e-3;
        k                   2e-4;
        omega               1e-5;
    }
}
relaxationFactors
{
    fields { p 0.3; }
    equations
    {
        U                   0.7;
        k                   0.7;
        omega               0.7;
    }
}
cache
{
    grad(U);
}
