boundaryField
{
    auv
    {
        type            omegaWallFunction;
        // __WALL_FUNCTION_BLENDING__
        value           uniform 1;
    }
    farField
    {
        type            freestream;
        freestreamValue uniform 1;
        value           uniform 1;
    }
}
