FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    __GEOMETRY_FILENAME__
    {
        type    triSurfaceMesh;
        name    auv;
    }
    nearBody
    {
        type    box;
        min     (-0.9 -0.7 -0.5);
        max     ( 0.9  0.7  0.5);
    }
    // __LOCKED_ROTOR_GEOMETRY__
}

castellatedMeshControls
{
    maxLocalCells       __MAX_LOCAL_CELLS__;
    maxGlobalCells      __MAX_GLOBAL_CELLS__;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    // The audited voxel-wrap triangles do not represent physical CAD creases.
    features ();

    refinementSurfaces
    {
        auv
        {
            level (__SURFACE_LEVELS__);
            patchInfo { type wall; }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        nearBody
        {
            mode inside;
            levels ((1e15 __NEAR_BODY_LEVEL__));
        }
        // __LOCKED_ROTOR_REFINEMENT__
    }

    locationInMesh      __LOCATION_IN_MESH__;
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        5;
    tolerance           2.0;
    nSolveIter          100;
    nRelaxIter          8;
    nFeatureSnapIter    8;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    layers              {};
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
    nRelaxIter          3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          1;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags (scalarLevels);
mergeTolerance 1e-6;
