# Python and notebooks
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/

# Experiment outputs and immutable local snapshots
runs/
logs/
results/
archives/
*.pt
*.onnx

# Let the OpenFOAM-local whitelist expose only the selected final fit while
# every other generated results directory remains ignored.
!environment/openfoam/results/

# OpenFOAM user-library build products (source and Make recipes remain tracked)
environment/openfoam/boundary_conditions/*/Make/linux*/
environment/openfoam/boundary_conditions/*/lnInclude/
